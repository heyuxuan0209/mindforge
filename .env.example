# Multi-AI Context Manager - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============ Claude API Configuration ============
# Official API: https://api.anthropic.com/v1
# Or use a proxy service in your region
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_API_TIMEOUT_MS=180000

# ============ Codex/GPT API Configuration ============
# OpenAI compatible API endpoint
# Official: https://api.openai.com/v1
# Or use proxy services like: https://api.openai-proxy.com/v1
CODEX_BASE_URL=https://api.openai.com/v1
CODEX_API_KEY=your_openai_api_key_here
CODEX_MODEL=gpt-4
CODEX_API_TIMEOUT_MS=180000

# Note: Some proxy services may use different model names
# Examples: gpt-4, gpt-4-turbo, gpt-4o, gpt-5.5 (depends on provider)

# ============ Gemini API Configuration (Optional) ============
# If you don't have Gemini API access, leave it empty
# The tool works fine with just Claude and Codex
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
GEMINI_API_TIMEOUT_MS=180000

# Optional global fallback used when a provider-specific timeout is not set.
AI_API_TIMEOUT_MS=180000

# ============ Service Configuration ============
PORT=3000
NODE_ENV=development
